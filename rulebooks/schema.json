{
  "$defs": {
    "Aerial": {
      "additionalProperties": false,
      "description": "Cable strung on existing poles (the imported pole layer).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Offer aerial spans where the data has poles",
          "title": "Enabled",
          "type": "boolean"
        },
        "max_span_m": {
          "default": 50.0,
          "description": "Longest span between two poles",
          "exclusiveMinimum": 0,
          "title": "Max Span M",
          "type": "number"
        },
        "pole_attach": {
          "default": 45.0,
          "description": "Attaching to one pole: clamp, bracket and the owner's fee",
          "title": "Pole Attach",
          "type": "number"
        },
        "transition": {
          "default": 250.0,
          "description": "Taking the cable down a pole into the ground: guard and pit",
          "title": "Transition",
          "type": "number"
        }
      },
      "title": "Aerial",
      "type": "object"
    },
    "BarrierCrossing": {
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "description": "Permit, launch and reception pits, mobilisation: once per crossing",
          "title": "Fixed",
          "type": "number"
        },
        "per_m": {
          "description": "Directional drilling under the barrier, per metre",
          "title": "Per M",
          "type": "number"
        }
      },
      "required": [
        "fixed",
        "per_m"
      ],
      "title": "BarrierCrossing",
      "type": "object"
    },
    "Chambers": {
      "additionalProperties": false,
      "properties": {
        "spacing_m": {
          "default": 250.0,
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Spacing M",
          "type": "number"
        },
        "types": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Types",
          "type": "object"
        }
      },
      "title": "Chambers",
      "type": "object"
    },
    "Closures": {
      "additionalProperties": false,
      "properties": {
        "sizes": {
          "default": [
            48,
            96,
            288
          ],
          "items": {
            "type": "integer"
          },
          "title": "Sizes",
          "type": "array"
        }
      },
      "title": "Closures",
      "type": "object"
    },
    "ConnectorsPerPath": {
      "additionalProperties": false,
      "properties": {
        "odf": {
          "default": 2,
          "title": "Odf",
          "type": "integer"
        },
        "fdh_in": {
          "default": 1,
          "title": "Fdh In",
          "type": "integer"
        },
        "fdh_out": {
          "default": 1,
          "title": "Fdh Out",
          "type": "integer"
        },
        "fat": {
          "default": 1,
          "title": "Fat",
          "type": "integer"
        },
        "ont": {
          "default": 1,
          "title": "Ont",
          "type": "integer"
        }
      },
      "title": "ConnectorsPerPath",
      "type": "object"
    },
    "Crossings": {
      "additionalProperties": false,
      "properties": {
        "road_drill_per_m": {
          "default": 180.0,
          "title": "Road Drill Per M",
          "type": "number"
        },
        "max_length_m": {
          "default": 80.0,
          "description": "Longest bore the engine offers under a motorway, railway or river; longer gaps are left to the detour",
          "title": "Max Length M",
          "type": "number"
        },
        "motorway": {
          "$ref": "#/$defs/BarrierCrossing",
          "default": {
            "fixed": 12000.0,
            "per_m": 350.0
          }
        },
        "railway": {
          "$ref": "#/$defs/BarrierCrossing",
          "default": {
            "fixed": 18000.0,
            "per_m": 450.0
          }
        },
        "water": {
          "$ref": "#/$defs/BarrierCrossing",
          "default": {
            "fixed": 9000.0,
            "per_m": 300.0
          }
        },
        "unmapped": {
          "$ref": "#/$defs/BarrierCrossing",
          "default": {
            "fixed": 12000.0,
            "per_m": 400.0
          },
          "description": "An obstacle the map does not show (streets close together that do not join); priced cautiously"
        }
      },
      "title": "Crossings",
      "type": "object"
    },
    "Distances": {
      "additionalProperties": false,
      "properties": {
        "max_drop_m": {
          "default": 150.0,
          "description": "Max drop length home \u2192 FAT along the street",
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Max Drop M",
          "type": "number"
        },
        "max_dist_m": {
          "default": 2000.0,
          "description": "Max distribution cable length FDH \u2192 FAT",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Max Dist M",
          "type": "number"
        },
        "max_reach_km": {
          "default": 20.0,
          "description": "Max reach OLT \u2192 ONT (G.984.1: 60 km logical at most)",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Max Reach Km",
          "type": "number"
        },
        "max_pull_m": {
          "default": 250.0,
          "description": "Max pull between chambers",
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Max Pull M",
          "type": "number"
        }
      },
      "title": "Distances",
      "type": "object"
    },
    "Ducts": {
      "additionalProperties": false,
      "properties": {
        "prefer_existing": {
          "default": true,
          "title": "Prefer Existing",
          "type": "boolean"
        },
        "max_fill_pct": {
          "default": 40.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Fill Pct",
          "type": "number"
        },
        "min_bend_radius_mm": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "title": "Min Bend Radius Mm",
          "type": "number"
        },
        "microduct_bundles": {
          "default": [
            7,
            12,
            24
          ],
          "items": {
            "type": "integer"
          },
          "title": "Microduct Bundles",
          "type": "array"
        }
      },
      "title": "Ducts",
      "type": "object"
    },
    "Facade": {
      "additionalProperties": false,
      "description": "Cable along building fronts: where a street is lined with buildings the cable runs on\ntheir walls instead of in a trench.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Offer facade routes (needs the owners' consent; off unless allowed)",
          "title": "Enabled",
          "type": "boolean"
        },
        "max_offset_m": {
          "default": 6.0,
          "description": "A wall counts as lining the street within this distance",
          "exclusiveMinimum": 0,
          "title": "Max Offset M",
          "type": "number"
        },
        "min_cover": {
          "default": 0.8,
          "description": "Share of a stretch of street that must be lined by walls",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Cover",
          "type": "number"
        },
        "highways": {
          "default": [
            "residential",
            "living_street",
            "unclassified",
            "service",
            "tertiary",
            "pedestrian"
          ],
          "description": "Street classes where facade cabling is allowed",
          "items": {
            "type": "string"
          },
          "title": "Highways",
          "type": "array"
        },
        "transition": {
          "default": 300.0,
          "description": "Taking the cable down a wall into the ground: guard and pit",
          "title": "Transition",
          "type": "number"
        }
      },
      "title": "Facade",
      "type": "object"
    },
    "Fat": {
      "additionalProperties": false,
      "properties": {
        "max_homes": {
          "default": 32,
          "description": "Max homes (units) served by one FAT",
          "maximum": 256,
          "minimum": 1,
          "title": "Max Homes",
          "type": "integer"
        },
        "min_homes": {
          "default": 4,
          "description": "Below this an FAT is discouraged (cost only)",
          "minimum": 0,
          "title": "Min Homes",
          "type": "integer"
        },
        "placements": {
          "default": [
            "pole",
            "wall",
            "chamber"
          ],
          "items": {
            "enum": [
              "pole",
              "wall",
              "chamber",
              "cabinet"
            ],
            "type": "string"
          },
          "title": "Placements",
          "type": "array"
        }
      },
      "title": "Fat",
      "type": "object"
    },
    "Fdh": {
      "additionalProperties": false,
      "properties": {
        "capacities": {
          "default": [
            288,
            576
          ],
          "description": "FDH sizes in splitter output ports",
          "items": {
            "type": "integer"
          },
          "title": "Capacities",
          "type": "array"
        },
        "max_fill_pct": {
          "default": 80.0,
          "description": "Max initial fill of an FDH",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Fill Pct",
          "type": "number"
        },
        "placements": {
          "default": [
            "cabinet"
          ],
          "items": {
            "enum": [
              "pole",
              "wall",
              "chamber",
              "cabinet"
            ],
            "type": "string"
          },
          "title": "Placements",
          "type": "array"
        }
      },
      "title": "Fdh",
      "type": "object"
    },
    "Fibers": {
      "additionalProperties": false,
      "properties": {
        "drop": {
          "default": 2,
          "description": "Fibres per drop cable",
          "maximum": 12,
          "minimum": 1,
          "title": "Drop",
          "type": "integer"
        },
        "distribution": {
          "default": [
            12,
            24,
            48,
            96,
            144,
            288
          ],
          "description": "Distribution cable ladder",
          "items": {
            "type": "integer"
          },
          "title": "Distribution",
          "type": "array"
        },
        "feeder": {
          "default": [
            96,
            144,
            288
          ],
          "description": "Feeder cable ladder",
          "items": {
            "type": "integer"
          },
          "title": "Feeder",
          "type": "array"
        },
        "spare_pct": {
          "default": 20.0,
          "description": "Spare fibres as % of demand, rounded up to ladder",
          "maximum": 200,
          "minimum": 0,
          "title": "Spare Pct",
          "type": "number"
        },
        "take_rate": {
          "default": 1.0,
          "description": "Share of homes passed that get a drop (0\u20131)",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Take Rate",
          "type": "number"
        }
      },
      "title": "Fibers",
      "type": "object"
    },
    "Homes": {
      "additionalProperties": false,
      "properties": {
        "count_units": {
          "default": true,
          "description": "Count dwelling units (busnummers / flats), not addresses",
          "title": "Count Units",
          "type": "boolean"
        },
        "default_units_apartment": {
          "default": 6,
          "description": "Units assumed for an apartment building with no unit data",
          "maximum": 500,
          "minimum": 1,
          "title": "Default Units Apartment",
          "type": "integer"
        },
        "m2_per_unit": {
          "default": 90.0,
          "description": "Floor area per unit used to estimate units from footprint \u00d7 levels",
          "maximum": 1000,
          "minimum": 15,
          "title": "M2 Per Unit",
          "type": "number"
        }
      },
      "title": "Homes",
      "type": "object"
    },
    "InsidePlant": {
      "additionalProperties": false,
      "description": "Fibre inside a building with several units: a riser from the building entry up through\nthe floors, a floor box on each floor, and a cable from the box to each flat.",
      "properties": {
        "floor_height_m": {
          "default": 3.0,
          "description": "Storey height used for the riser length",
          "maximum": 8,
          "minimum": 2,
          "title": "Floor Height M",
          "type": "number"
        },
        "units_per_floor": {
          "default": 4,
          "description": "Flats per floor, to estimate the floors of a building whose levels are unknown",
          "title": "Units Per Floor",
          "type": "integer"
        },
        "units_per_floor_box": {
          "default": 8,
          "description": "Flats one floor box serves",
          "minimum": 1,
          "title": "Units Per Floor Box",
          "type": "integer"
        },
        "riser_per_m": {
          "default": 2.5,
          "description": "Riser cable and its fixing, per metre",
          "title": "Riser Per M",
          "type": "number"
        },
        "floor_box": {
          "default": 70.0,
          "description": "One floor box (splice/patch point on a floor)",
          "title": "Floor Box",
          "type": "number"
        },
        "indoor_per_unit": {
          "default": 55.0,
          "description": "Cable from the floor box to one flat with its wall outlet",
          "title": "Indoor Per Unit",
          "type": "number"
        },
        "riser_install_per_floor": {
          "default": 60.0,
          "description": "Labour to install the riser, per floor",
          "title": "Riser Install Per Floor",
          "type": "number"
        }
      },
      "title": "InsidePlant",
      "type": "object"
    },
    "Labour": {
      "additionalProperties": false,
      "properties": {
        "splice": {
          "default": 18.0,
          "title": "Splice",
          "type": "number"
        },
        "otdr_test": {
          "default": 12.0,
          "title": "Otdr Test",
          "type": "number"
        },
        "fat_install": {
          "default": 180.0,
          "title": "Fat Install",
          "type": "number"
        },
        "fdh_install": {
          "default": 1200.0,
          "title": "Fdh Install",
          "type": "number"
        }
      },
      "title": "Labour",
      "type": "object"
    },
    "LossDb": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "default": 0.3,
          "description": "Loss per mated connector pair",
          "maximum": 1.0,
          "minimum": 0,
          "title": "Connector",
          "type": "number"
        },
        "splice": {
          "default": 0.1,
          "description": "Loss per fusion splice",
          "maximum": 0.5,
          "minimum": 0,
          "title": "Splice",
          "type": "number"
        },
        "margin": {
          "default": 2.0,
          "description": "Design margin added to every path",
          "maximum": 10,
          "minimum": 0,
          "title": "Margin",
          "type": "number"
        },
        "splitter": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Splitter",
          "type": "object"
        },
        "fiber_per_km": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Fiber Per Km",
          "type": "object"
        },
        "coexistence": {
          "default": 1.0,
          "description": "Insertion loss of the coexistence element (WDM1r) when GPON and XGS-PON share an ODN",
          "maximum": 3,
          "minimum": 0,
          "title": "Coexistence",
          "type": "number"
        }
      },
      "title": "LossDb",
      "type": "object"
    },
    "Phasing": {
      "additionalProperties": false,
      "description": "Building the network in phases: cabinet areas grouped into `phases` of about equal units.",
      "properties": {
        "phases": {
          "default": 1,
          "description": "Number of build phases (1: build it all at once)",
          "maximum": 20,
          "minimum": 1,
          "title": "Phases",
          "type": "integer"
        },
        "order": {
          "default": "density",
          "description": "Which cabinet areas come first: density (most units per metre of cable, the best business case) or distance (nearest the POP first)",
          "enum": [
            "density",
            "distance"
          ],
          "title": "Order",
          "type": "string"
        }
      },
      "title": "Phasing",
      "type": "object"
    },
    "Pon": {
      "additionalProperties": false,
      "properties": {
        "technology": {
          "default": "gpon",
          "description": "gpon (G.984), xgspon (G.9807.1, 10G symmetric) or gpon+xgspon: both on one ODN through a coexistence element, whose loss (loss_db.coexistence) every path pays",
          "enum": [
            "gpon",
            "xgspon",
            "gpon+xgspon"
          ],
          "title": "Technology",
          "type": "string"
        },
        "class": {
          "default": "B+",
          "description": "ODN loss class: B+ or C+ for GPON, N1, N2, E1 or E2 for XGS-PON (with both on one ODN, the tighter of the two classes in use)",
          "enum": [
            "B+",
            "C+",
            "N1",
            "N2",
            "E1",
            "E2"
          ],
          "title": "Class",
          "type": "string"
        },
        "budget_db": {
          "default": 28.0,
          "description": "Max ODN loss for the class (B+ = 28 dB)",
          "title": "Budget Db",
          "type": "number"
        },
        "min_loss_db": {
          "default": 13.0,
          "description": "Min ODN loss for the class (B+ = 13 dB)",
          "title": "Min Loss Db",
          "type": "number"
        },
        "max_differential_db": {
          "default": 15.0,
          "description": "Max difference in loss between ONTs on one PON",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Max Differential Db",
          "type": "number"
        },
        "split_ratio": {
          "default": 32,
          "description": "Total split per PON (1:N)",
          "title": "Split Ratio",
          "type": "integer"
        },
        "cascade": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cascaded split stages, e.g. [4, 8]. None means a single centralised splitter in the FDH.",
          "title": "Cascade"
        },
        "worst_case_nm": {
          "default": 1310,
          "description": "Wavelength used for the worst-case budget check: 1310 nm (GPON upstream), 1270 nm (XGS-PON upstream, the worse of the two when XGS-PON is on the ODN)",
          "enum": [
            1270,
            1310,
            1490,
            1550,
            1577
          ],
          "title": "Worst Case Nm",
          "type": "integer"
        },
        "architecture": {
          "anyOf": [
            {
              "enum": [
                "centralised",
                "cascaded",
                "p2p"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "centralised: one splitter per PON in the FDH; cascaded: `cascade` stages, the first in the FDH and the second in each FAT; p2p: no splitters, one fibre per unit from the POP. Left out, it follows `cascade`.",
          "title": "Architecture"
        },
        "p2p_budget_db": {
          "default": 14.0,
          "description": "Loss budget of point-to-point optics (1000BASE-BX20 class); used instead of budget_db when the architecture is p2p",
          "exclusiveMinimum": 0,
          "maximum": 40,
          "title": "P2P Budget Db",
          "type": "number"
        }
      },
      "title": "Pon",
      "type": "object"
    },
    "Pops": {
      "additionalProperties": false,
      "properties": {
        "max_units": {
          "default": 4096,
          "description": "Units one POP (OLT site) serves; an area with more gets several POPs, each with its own catchment",
          "minimum": 1,
          "title": "Max Units",
          "type": "integer"
        }
      },
      "title": "Pops",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "The rulebook's status. Shipped presets are beta: typical values for a first design,\nto be set to your own prices and local rules.",
      "properties": {
        "status": {
          "default": "beta",
          "enum": [
            "beta",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name and role of the reviewing engineer",
          "title": "Reviewed By"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date of the review (YYYY-MM-DD)",
          "title": "Date"
        },
        "note": {
          "default": "Beta preset: typical values; set your own prices and local rules.",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "Routing": {
      "additionalProperties": false,
      "properties": {
        "exclude_highways": {
          "default": [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link",
            "steps",
            "escalator",
            "elevator",
            "corridor",
            "platform",
            "raceway",
            "bus_guideway",
            "proposed",
            "construction",
            "abandoned"
          ],
          "description": "OSM highway classes no cable may follow: you cannot trench a motorway or a staircase",
          "items": {
            "type": "string"
          },
          "title": "Exclude Highways",
          "type": "array"
        }
      },
      "title": "Routing",
      "type": "object"
    },
    "Slack": {
      "additionalProperties": false,
      "properties": {
        "per_closure_m": {
          "default": 10.0,
          "title": "Per Closure M",
          "type": "number"
        },
        "per_fat_m": {
          "default": 5.0,
          "title": "Per Fat M",
          "type": "number"
        }
      },
      "title": "Slack",
      "type": "object"
    },
    "SurfaceCost": {
      "additionalProperties": false,
      "properties": {
        "trench_per_m": {
          "title": "Trench Per M",
          "type": "number"
        },
        "reinstatement_per_m": {
          "default": 0.0,
          "title": "Reinstatement Per M",
          "type": "number"
        }
      },
      "required": [
        "trench_per_m"
      ],
      "title": "SurfaceCost",
      "type": "object"
    },
    "Surfaces": {
      "additionalProperties": false,
      "properties": {
        "asphalt": {
          "$ref": "#/$defs/SurfaceCost",
          "default": {
            "trench_per_m": 90.0,
            "reinstatement_per_m": 35.0
          }
        },
        "pavement": {
          "$ref": "#/$defs/SurfaceCost",
          "default": {
            "trench_per_m": 60.0,
            "reinstatement_per_m": 20.0
          }
        },
        "verge": {
          "$ref": "#/$defs/SurfaceCost",
          "default": {
            "trench_per_m": 35.0,
            "reinstatement_per_m": 5.0
          }
        },
        "aerial": {
          "$ref": "#/$defs/SurfaceCost",
          "default": {
            "trench_per_m": 20.0,
            "reinstatement_per_m": 0.0
          }
        },
        "facade": {
          "$ref": "#/$defs/SurfaceCost",
          "default": {
